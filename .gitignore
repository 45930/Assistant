# Secrets — NEVER commit
.env
.mcp.json
secrets/
*.key
*.pem
**/auth-profiles.json
**/auth.json
**/credentials/

# Org config (contains company-specific identifiers)
jobs/org.yaml

# OpenClaw state (sessions, agent runtime data)
**/agents/*/sessions/
**/sandboxes/
**/*.sock

# OS
.DS_Store
Thumbs.db

# n8n data (managed separately by n8n's own persistence)
n8n_data/

# Personal config (generated by setup)
CLAUDE.md

# Claude Code project config (generated from setup/templates/claude/ by configure.sh)
.claude/

# All personal data
context/**

# Node
**/node_modules/

# Runtime state
**/.last_run
**/.last_run_email

# Slack channel config (contains workspace-specific channel names)
jobs/slack-pull/scripts/config.json

# Temp
*.tmp
*.log
